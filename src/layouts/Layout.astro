---
import { getCollection, type CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import logo from "../../_source/img/logo-mark.png";
import Icon from "../components/Icon.astro";
import FooterLink from "../components/FooterLink.astro";
import LangTag from "../components/LangTag.astro";
import { languages, ui } from "../data/ui";
import { url, absolute } from "../lib/urls";
import { downloads, downloadTitle } from "../data/downloads";
import { serviceKeys, aviationKeys, serviceTitle } from "../data/sections";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "../styles/global.css";
interface Props {
  page: CollectionEntry<"pages">["data"];
}
const { page } = Astro.props;
const pages = await getCollection("pages");
const t = ui[page.lang];
const find = (key: string, lang = page.lang) =>
  pages.find((p) => p.data.key === key && p.data.lang === lang)?.data;
const home = find("home")!;
const contact = find("contact") || find("contact", "en")!;
const aviation = find("aviation") || find("aviation", "en")!;
const references = find("references") || find("references", "en")!;
const services = serviceKeys.map((key) => find(key) || find(key, "en")!);
const aviationPages = aviationKeys.map((key) => find(key) || find(key, "en")!);
const divisionEmail =
  page.kind === "aviation"
    ? "info.aviation@testing-service.org"
    : "jakub.kubis@testing-service.org";
const accreditation = downloads.find((file) => file.file === "TS-Opravnenie.pdf")!;
const alternates = pages.filter((p) => p.data.key === page.key);
const defaultPage =
  find(page.key, "sk") ||
  alternates.find((p) => p.data.lang === "en")?.data ||
  home;
const indexable =
  import.meta.env.PUBLIC_INDEXABLE === "true" && page.key !== "not-found";
const canonical = absolute(
  page.path ? page.path + (page.path.endsWith(".html") ? "" : "/") : "",
  Astro.site,
);
---

<!doctype html>
<html lang={page.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{page.title === 'Testing Service' ? `${page.title} — ${page.description}` : `${page.title} | Testing Service`}</title>
    <meta name="description" content={page.description} />
    <meta name="robots" content={indexable ? "index, follow" : "noindex"} />
    <link rel="canonical" href={canonical} />
    {alternates.map((p) => (
      <link
        rel="alternate"
        hreflang={p.data.lang}
        href={absolute(p.data.path ? p.data.path + "/" : "", Astro.site)}
      />
    ))}
    {page.key !== "not-found" && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={absolute(
          defaultPage.path ? defaultPage.path + "/" : "",
          Astro.site,
        )}
      />
    )}
    <link rel="icon" href={url("favicon.ico")} sizes="any" />
    <meta property="og:title" content={`${page.title} | Testing Service`} />
    <meta property="og:description" content={page.description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#18292e" />
  </head>
  <body class:list={[page.kind === "aviation" && "aviation"]}>
    <header class="site-header">
      <a href="#main" class="skip-link">
        {t.skip}
      </a>
      <div class="header-inner wrap">
        <a
          class="brand"
          href={url(home.path ? home.path + "/" : "")}
          aria-label={`Testing Service — ${t.home.toLowerCase()}`}
        >
          <Image
            src={logo}
            alt=""
            width={80}
            height={80}
            fit="contain"
            format="webp"
            loading="eager"
          />
          <span lang="en">TESTING SERVICE</span>
        </a>
        <nav class="language-switcher" aria-label={t.language}>
          {languages.map((lang) => {
            const equivalent = find(page.key, lang);
            const target = equivalent || find("home", lang)!;
            const fallback = !equivalent ? ` — ${ui[lang].home}` : "";
            return (
              <a
                href={url(target.path ? target.path + "/" : "")}
                lang={lang}
                aria-label={
                  { sk: "SK — Slovenčina", en: "EN — English", zh: "中文" }[
                    lang
                  ] + fallback
                }
                title={fallback ? ui[lang].home : undefined}
                aria-current={lang === page.lang ? "true" : undefined}
              >
                {lang === "zh" ? "中文" : lang.toUpperCase()}
              </a>
            );
          })}
        </nav>
        <button
          class="menu-toggle"
          aria-label={t.menu}
          aria-expanded="false"
          aria-controls="main-navigation"
          data-open={t.menu}
          data-close={t.close}
        >
          <Icon name="menu" />
          <span class="menu-close">
            <Icon name="close" />
          </span>
          <span class="menu-label">{t.menu}</span>
        </button>
        <nav id="main-navigation" class="main-navigation" aria-label={t.menu}>
          <span class="eyebrow mobile-services-label">{t.services}</span>
          <details class="services-menu">
            <summary class:list={[page.kind === "service" && "current"]}>
              {t.services}
              <Icon name="chevron" />
            </summary>
            <div class="dropdown">
              <a
                class="dropdown-intro"
                href={url(home.path ? `${home.path}/#services` : "#services")}
              >
                {t.all}
                <Icon />
              </a>
              {services.map((p) => (
                <a
                  href={url(p.path + "/")}
                  aria-current={page.path === p.path ? "page" : undefined}
                >
                  <span>
                    {serviceTitle(p, page.lang)}
                    <LangTag current={page.lang} target={p.lang} />
                  </span>
                  <Icon />
                </a>
              ))}
            </div>
          </details>
          <a
            href={url(aviation.path + "/")}
            aria-current={page.kind === "aviation" ? "page" : undefined}
          >
            <span>
              {t.aviation}
              <LangTag current={page.lang} target={aviation.lang} />
            </span>
            <span class="mobile-nav-arrow"><Icon /></span>
          </a>
          <a
            href={url(references.path + "/")}
            aria-current={page.kind === "references" ? "page" : undefined}
          >
            <span>
              {t.references}
              <LangTag current={page.lang} target={references.lang} />
            </span>
            <span class="mobile-nav-arrow"><Icon /></span>
          </a>
          <a
            class:list={[
              "button button-header header-cta",
              page.kind === "contact" && "button-secondary",
            ]}
            aria-current={page.kind === "contact" ? "page" : undefined}
            href={url(contact.path + "/")}
          >
            <span>
              {t.cta}
              <LangTag current={page.lang} target={contact.lang} />
            </span>
            <Icon />
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer on-dark">
      {page.kind !== "contact" && (
        <div class="wrap footer-top grid">
          <div class="footer-closing">
            <h2>{t.ctaQuestion}</h2>
            {page.closing && page.closing !== t.ctaQuestion && <p>{page.closing}</p>}
          </div>
          <div class="footer-action">
            <a class="footer-email" href={`mailto:${divisionEmail}`}>
              <span class="nowrap">{divisionEmail}<Icon name="external" /></span>
            </a>
            <a
              class="button button-on-dark"
              href={url(contact.path + "/#enquiry")}
            >
              <span>
                {t.enquiry}
                <LangTag current={page.lang} target={contact.lang} />
              </span>
              <Icon />
            </a>
          </div>
        </div>
      )}
      <div class="wrap footer-grid grid">
        <div>
          <h3 class="type-h4" lang="en">
            Testing Service s.r.o.
          </h3>
          <p lang={page.lang === "sk" ? "sk" : "en"}>
            Timravy 31
            <br />
            036 01 Martin
            <br />
            {page.lang === "sk" ? "Slovensko" : "Slovakia"}
          </p>
        </div>
        <div>
          <h3 class="type-h4">{t.legal}</h3>
          <p lang="sk">
            Okresný súd Žilina
            <br />
            odd. Sro, vložka č. 118043/L
          </p>
          <p>
            IČO: 36677213
            <br />
            IČ DPH: SK2022243982
          </p>
          <FooterLink href={url("ochrana-osobnych-udajov/")} title={t.privacy} current={page.lang} target="sk" />
          <FooterLink href={url("s/" + accreditation.file)} title={downloadTitle(accreditation, page.lang)} current={page.lang} target={accreditation.lang} download />
        </div>
        <div>
          <h3 class="type-h4">{t.services}</h3>
          <ul>{services.map((p) => <li><FooterLink href={url(p.path + "/")} title={serviceTitle(p, page.lang)} current={page.lang} target={p.lang} /></li>)}</ul>
        </div>
        <div>
          <h3 class="type-h4">{t.aviation}</h3>
          <p lang="en">Aviation Testing Center · Žilina (LZZI)</p>
          {page.kind !== "aviation" && <FooterLink href="mailto:info.aviation@testing-service.org" title="info.aviation@testing-service.org" current={page.lang} />}
          <ul>{aviationPages.map((p) => <li><FooterLink href={url(p.path + "/")} title={p.title} current={page.lang} target={p.lang} textLang={p.lang} /></li>)}</ul>
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>© Testing Service s.r.o.</span>
        <span class="tagline" lang="en">
          Inspection · Certification · Permit
        </span>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#main-navigation");
      const dropdown =
        document.querySelector<HTMLDetailsElement>(".services-menu");
      document.documentElement.classList.add("js");
      const desktop = matchMedia("(min-width: 1080px)");
      const close = () => {
        toggle?.setAttribute("aria-expanded", "false");
        nav?.classList.remove("is-open");
        if (toggle) toggle.setAttribute("aria-label", toggle.dataset.open!);
        document.documentElement.classList.remove("menu-open");
        if (dropdown) dropdown.open = false;
      };
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") !== "true";
        toggle.setAttribute("aria-expanded", String(open));
        nav?.classList.toggle("is-open", open);
        document.documentElement.classList.toggle("menu-open", open);
        toggle.setAttribute(
          "aria-label",
          open ? toggle.dataset.close! : toggle.dataset.open!,
        );
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          if (dropdown?.open && desktop.matches) {
            dropdown.open = false;
            dropdown.querySelector("summary")?.focus();
          } else if (toggle?.getAttribute("aria-expanded") === "true") {
            close();
            toggle.focus();
          }
        }
      });
      document.addEventListener("click", (event) => {
        if (
          desktop.matches &&
          dropdown?.open &&
          !dropdown.contains(event.target as Node)
        )
          dropdown.open = false;
      });
      nav?.addEventListener("focusout", () => {
        setTimeout(() => {
          if (
            desktop.matches &&
            !nav.contains(document.activeElement) &&
            dropdown
          )
            dropdown.open = false;
        }, 0);
      });
      nav
        ?.querySelectorAll("a")
        .forEach((a) => a.addEventListener("click", close));
      desktop.addEventListener("change", close);
      const activeTab = document.querySelector<HTMLElement>(
        '.section-nav [aria-current="page"]',
      );
      const tabs = activeTab?.parentElement;
      if (activeTab && tabs) {
        const updateFade = () => tabs.classList.toggle("has-overflow", tabs.scrollWidth > tabs.clientWidth + tabs.scrollLeft + 1);
        const alignTab = () => {
          if (matchMedia("(width < 640px)").matches)
            activeTab.scrollIntoView({ inline: "start", block: "nearest", behavior: "instant" });
          updateFade();
        };
        document.fonts.ready.then(alignTab);
        tabs.addEventListener("scroll", updateFade, { passive: true });
        window.addEventListener("resize", alignTab);
      }
    </script>
    <script>
      const contentsLinks = [
        ...document.querySelectorAll<HTMLAnchorElement>(".contents a"),
      ];
      const sections = contentsLinks.map((link) =>
        document.getElementById(decodeURIComponent(link.hash.slice(1))),
      );
      let queued = false;
      const updateContents = () => {
        queued = false;
        let active = 0;
        sections.forEach((section, index) => {
          if (section && section.getBoundingClientRect().top <= 120)
            active = index;
        });
        contentsLinks.forEach((link, index) => {
          if (index === active) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        });
      };
      if (contentsLinks.length) {
        updateContents();
        document.addEventListener(
          "scroll",
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(updateContents);
            }
          },
          { passive: true },
        );
      }
    </script>
  </body>
</html>
