---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import partners from "../../_source/img/Na%C5%A1i_Partneri.jpg";
import Icon from "../components/Icon.astro";
import LangTag from "../components/LangTag.astro";
import LinkList, { type Row } from "../components/LinkList.astro";
import Photo from "../components/Photo.astro";
import Logos from "../components/Logos.astro";
import ContactForm from "../components/ContactForm.astro";
import { ui } from "../data/ui";
import { downloads, downloadTitle, downloadOrder } from "../data/downloads";
import { serviceKeys, aviationKeys, serviceTitle } from "../data/sections";
import homeCopy from "../data/home.json";
import gallery from "../data/gallery.json";
import redirects from "../data/redirects.json";
import { url, absolute } from "../lib/urls";
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return [
    ...pages.map((page) => ({
      params: { path: page.data.path || undefined },
      props: { page },
    })),
    ...Object.entries(redirects).map(([path, target]) => ({
      params: { path },
      props: { target },
    })),
  ];
}
interface Props {
  page?: CollectionEntry<"pages">;
  target?: string;
}
const { page, target } = Astro.props;
const all = await getCollection("pages");
const d = page?.data;
const lang = d?.lang || "sk";
const t = ui[lang];
const find = (key: string) =>
  all.find((p) => p.data.key === key && p.data.lang === lang) ||
  all.find((p) => p.data.key === key && p.data.lang === "en");
const services = serviceKeys.map((key) => find(key)!);
const aviation = aviationKeys.map((key) => find(key)!);
const content = page ? await render(page) : undefined;
const Content = content?.Content;
const headings = content?.headings.filter((h) => h.depth === 2) || [];
// Do not repeat a document already linked directly in the source prose.
const relevantDownloads = downloads
  .filter((f) => f.page === d?.key && !page?.body?.includes("/s/" + f.file))
  .sort((a, b) => downloadOrder.indexOf(a.kind) - downloadOrder.indexOf(b.kind));
const copy = homeCopy[lang];
// The compliance sentence is existing source copy in all three languages.
const homeLead = {
  sk: "Splnenie českých a slovenských legislatívnych požiadaviek pre vašu technológiu",
  en: "Managing Czech and Slovak legal requirements of your technology",
  zh: "管理您技术在捷克和斯洛伐克的法律合规要求",
}[lang];
const rows: Row[] = relevantDownloads.map((f) => ({
  title: downloadTitle(f, lang),
  lang: f.lang,
  href: url("s/" + f.file),
  meta: f.file.split(".").pop()?.toUpperCase(),
  download: true,
}));
if (d?.kind === "references") {
  if (lang === "en")
    rows.push(
      {
        title: "Promotional presentation",
        href: "https://drive.google.com/file/d/1wDjKAScMM4idIgvG_27cAyZavl46cln0/view?usp=sharing",
      },
    );
  else
    rows.push({
      title: "我们的宣传介绍",
      href: "https://drive.google.com/file/d/1fGjFYueDh0oi0DWyY603WWtxajNFD-Wq/view?usp=sharing",
    });
}
if (d?.key === "aviation") {
  rows.push(
    {
      title: "EASA · No 2018/1139",
      href: "https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32018R1139",
    },
    {
      title: "EASA · No 1321/2014",
      href: "https://eur-lex.europa.eu/legal-content/CS/TXT/?qid=1551125876356&uri=CELEX:32014R1321",
    },
  );
  if (lang === "sk")
    rows.push({
      title: "No 216/2008 · ucl.cz",
      href: "http://www.caa.cz/file/6475/",
    });
}
const featuredNames = [
  "TESTING_CENTER-26%5B203%5D.jpg",
  "TESTING_CENTER-33%5B210%5D.jpg",
  "TESTING_CENTER-18%5B195%5D.jpg",
  "TESTING_CENTER-10%5B187%5D.jpg",
  "TESTING_CENTER-36%5B213%5D.jpg",
  "TESTING_CENTER-32%5B209%5D.jpg",
  "AT1.png",
  "TESTING_CENTER-06%5B183%5D.jpg",
];
const featured = featuredNames.map((name) =>
  gallery.find((p) => p.image === name)!,
);
const remaining = gallery.filter((p) => !featuredNames.includes(p.image));
const aerials = remaining.filter((p) => p.image.startsWith("Nad_"));
const otherPhotos = remaining.filter((p) => !p.image.startsWith("Nad_"));
---

{target !== undefined ? (
  <html
    lang={
      target.replace(/^\//, "").startsWith("en/")
        ? "en"
        : target.replace(/^\//, "").startsWith("zh/")
          ? "zh"
          : "sk"
    }
  >
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>Testing Service — Page moved</title>
      <meta name="robots" content="noindex" />
      <meta http-equiv="refresh" content={`0;url=${url(target)}`} />
      <link rel="canonical" href={absolute(target, Astro.site)} />
    </head>
    <body>
      <p>
        This page has moved.{" "}
        <a id="destination" href={url(target)}>
          Continue to Testing Service
        </a>
        .
      </p>
      <script is:inline>
        location.replace(
          document.getElementById("destination").href +
            location.search +
            location.hash,
        );
      </script>
    </body>
  </html>
) : (
  d && (
    <Layout page={d}>
      {d.kind === "home" ? (
        <>
          <section class="home-hero on-dark">
            <div class="hero-copy">
              <span class="eyebrow" lang={lang === "zh" ? "en" : lang}>
                {(lang === "sk" ? ["Inšpekcie", "Certifikácie", "Povolenia"] : ["Inspection", "Certification", "Permit"]).map((item) => <><span class="nowrap">{item}&nbsp;·</span>{" "}</>)}
                <span class="nowrap">CZ&nbsp;+&nbsp;SK</span>
              </span>
              <h1>
                {lang === "zh" ? (
                  homeLead
                    .split(/(?=在捷克|和斯洛伐克|的法律合规要求)/)
                    .map((phrase, index) => (
                      <>
                        <span class="nowrap">
                          {phrase}
                          {index === 3 && <span class="gold">.</span>}
                        </span>
                        {index < 3 && <wbr />}
                      </>
                    ))
                ) : (
                  <>
                    {homeLead}
                    <span class="gold">.</span>
                  </>
                )}
              </h1>

              <a class="button button-on-dark" href="#services">
                {t.offer}
                <Icon name="down" />
              </a>
            </div>
            <div class="hero-visual">
              <Photo
                name={d.image!}
                alt={
                  lang === "sk"
                    ? "Priemyselná výrobná linka"
                    : "Industrial production line"
                }
                eager
                widths={[720, 1080, 1440, 1500]}
                ratio={0}
                sizes="(min-width: 1080px) max(42vw, 1080px), 100vw"
              />
            </div>
          </section>
          <section class="clients wrap">
            <div class="section-label">
              <span class="eyebrow">{t.clients}</span>
              <a
                class="text-link"
                href={url(find("references")!.data.path + "/")}
              >
                <span>
                  {t.references}
                  <LangTag
                    current={lang}
                    target={find("references")!.data.lang}
                  />
                </span>
                <Icon />
              </a>
            </div>
            <Logos />
          </section>
          <section class="intro-section wrap grid">
            {copy.intro.split("\n\n").map((p, i) => (
              <p class={i === 0 ? "statement" : undefined}>{p}</p>
            ))}
          </section>
          <section class="services-section" id="services">
            <div class="wrap">
              <div class="section-head">
                <h2>{t.offer}</h2>
              </div>
              <div class="service-grid">
                {services.map((p, i) => (
                  <a class="service-card" href={url(p.data.path + "/")}>
                    <div class="card-content">
                      <span class="card-number">0{i + 1}</span>
                      <h3>{serviceTitle(p.data, lang)}</h3>
                      <p>{lang === "zh" ? copy.services[i].description.split("。")[0] + "。" : copy.services[i].description}</p>
                      <span class="text-link">
                        <span>
                          {t.more}
                          <LangTag current={lang} target={p.data.lang} />
                        </span>
                        <Icon />
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          </section>
          <section class="wrap packages">
            <div>
              <div class="section-head">
                <h2>{t.packages}</h2>
                <p class="lead">{d.packageLead}</p>
              </div>
              {copy.capabilities.length > 0 && (
                <ul class="list capabilities">
                  {copy.capabilities.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
              )}
              <details class="disclosure">
                <summary>
                  {t.packageDetails}
                  <Icon name="plus" />
                </summary>
                <div class="prose">{Content && <Content />}</div>
              </details>
            </div>
          </section>
          {
            <section class="aviation-feature aviation-scope">
              <div class="wrap aviation-feature-grid grid">
                <Photo
                  name="TESTING_CENTER-21%5B198%5D.jpg"
                  alt="Aviation Testing Center, Žilina"
                />
                <div>
                  <h2 lang="en">Testing Service Aviation</h2>
                  {lang !== "zh" && (
                    <p class="lead">{aviation[0].data.description}</p>
                  )}
                  <a
                    class="button button-secondary"
                    href={url(aviation[0].data.path + "/")}
                  >
                    <span>
                      {t.more}
                      <LangTag current={lang} target={aviation[0].data.lang} />
                    </span>
                    <Icon />
                  </a>
                </div>
              </div>
            </section>
          }
        </>
      ) : (
        <>
          <nav class="wrap breadcrumb" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href={url(lang === "sk" ? "" : lang + "/")}>{t.home}</a>
              </li>
              {d.kind === "service" && (
                <li>
                  <a
                    href={url(
                      lang === "sk" ? "#services" : lang + "/#services",
                    )}
                  >
                    {t.services}
                  </a>
                </li>
              )}
              {d.kind === "aviation" && d.key !== "aviation" && (
                <li>
                  <a href={url(aviation[0].data.path + "/")}>Aviation</a>
                </li>
              )}
              {d.kind !== "aviation" && <li aria-current="page">{d.title}</li>}
            </ol>
          </nav>
          {d.kind === "aviation" && (
            <nav class="section-nav wrap" aria-label="Aviation">
              {aviation.map((p) => (
                <a
                  href={url(p.data.path + "/")}
                  aria-current={d.path === p.data.path ? "page" : undefined}
                >
                  {p.data.title}
                </a>
              ))}
            </nav>
          )}
          <section class:list={["page-hero wrap grid", d.image && "has-photo"]}>
            <div>
              <h1>
                {d.title}
                <span class="gold">.</span>
              </h1>
              <p class="lead">{d.description}</p>
              {rows.length > 0 &&
                (d.kind === "service" || d.kind === "aviation") && (
                  <a class="button button-secondary" href="#downloads">
                    {t.downloads}
                    <Icon name="down" />
                  </a>
                )}
            </div>
            {d.image && (
              <Photo
                name={d.image}
                alt={d.kind === "aviation" ? "Testing Service Aviation" : ""}
                eager
                sizes="(min-width: 1080px) 37vw, 100vw"
              />
            )}
          </section>
          {d.kind === "references" && (
            <section class="wrap clients reference-clients">
              <Logos />
            </section>
          )}
          {d.kind === "contact" ? (
            <section class="wrap contact-layout grid">
              <div class="contact-details">
                <h2 class="type-h3">Testing Service s.r.o.</h2>
                <p class="address">
                  Timravy 31
                  <br />
                  036 01 Martin
                  <br />
                  {lang === "sk" ? "Slovensko" : "Slovakia"}
                </p>
                <LinkList
                  lang={lang}
                  rows={[
                    {
                      title: "jakub.kubis@testing-service.org",
                      href: "mailto:jakub.kubis@testing-service.org",
                      meta: "E-MAIL",
                    },
                  ]}
                />
                <h3>Aviation</h3>
                <LinkList
                  lang={lang}
                  rows={[
                    {
                      title: "info.aviation@testing-service.org",
                      href: "mailto:info.aviation@testing-service.org",
                      meta: "E-MAIL",
                    },
                  ]}
                />
                <div class="future-office">
                  <span class="eyebrow">{t.soon}</span>
                  <h3>{lang === "sk" ? "Praha" : "Prague"}</h3>
                  <p>
                    Forum Karlín, Pernerova 51
                    <br />
                    {lang === "sk"
                      ? "Praha, Česká republika"
                      : "Prague, Czech Republic"}
                  </p>
                </div>
              </div>
              <div id="enquiry" class="contact-form-col">
                <ContactForm lang={lang} />
              </div>
            </section>
          ) : (
            <div class="wrap article-layout grid">
              <aside>
                {headings.length >= 2 &&
                  headings.every((h) => h.text.length <= 80) && (
                    <nav class="contents" aria-label={t.toc}>
                      <span class="eyebrow">{t.toc}</span>
                      {headings.map((h) => (
                        <a href={"#" + h.slug}>{h.text}</a>
                      ))}
                    </nav>
                  )}
              </aside>
              <div>
                <article class="prose">{Content && <Content />}</article>
                {rows.length > 0 && (
                  <section class="downloads" id="downloads">
                    <h2 class="type-h3">{t.downloadsLinks}</h2>
                    <LinkList rows={rows} lang={lang} />
                  </section>
                )}
                {d.key === "aviation" && (
                  <section class="partners">
                    <h2 class="type-h3">
                      {lang === "sk" ? "Naši partneri" : "Our partners"}
                    </h2>
                    <Image
                      src={partners}
                      alt="Žilinská univerzita – Letecké výcvikové a vzdelávacie centrum; Letisko Žilina"
                      width={480}
                      format="webp"
                      loading="lazy"
                    />
                  </section>
                )}
              </div>
            </div>
          )}
          {d.kind === "service" && (
            <section class="wrap related grid">
              <span class="eyebrow">{t.related}</span>
              <LinkList lang={lang} rows={services.filter((p) => p.data.key !== d.key).map((p) => ({ title: serviceTitle(p.data, lang), href: url(p.data.path + "/"), lang: p.data.lang }))} />
            </section>
          )}
          {d.key === "aviation" && (
            <section class="gallery">
              <div class="wrap">
                <div class="section-head">
                  <span class="eyebrow">Žilina · LZZI</span>
                  <h2>{t.gallery}</h2>
                </div>
                <div class="gallery-grid">
                  {featured.map((p) => (
                    <Photo
                      name={p.image}
                      alt={p.alt[lang === "sk" ? "sk" : "en"]}
                      sizes="(min-width: 640px) 25vw, 50vw"
                    />
                  ))}
                </div>
                <details class="disclosure gallery-more">
                  <summary>
                    {t.morePhotos} ({remaining.length})<Icon name="plus" />
                  </summary>
                  <div class="gallery-grid">
                    {otherPhotos.map((p) => (
                      <Photo
                        name={p.image}
                        alt={p.alt[lang === "sk" ? "sk" : "en"]}
                        widths={[400, 760]}
                        sizes="(min-width: 640px) 25vw, 50vw"
                      />
                    ))}
                  </div>
                  <div class="aerial-group" role="group" aria-label={t.aerials}>
                    <h3>{t.aerials}</h3>
                    <div class="gallery-grid">
                      {aerials.map((p) => (
                        <Photo
                          name={p.image}
                          alt=""
                          widths={[400, 760]}
                          sizes="(min-width: 640px) 25vw, 50vw"
                        />
                      ))}
                    </div>
                  </div>
                </details>
              </div>
            </section>
          )}
        </>
      )}
    </Layout>
  )
)}
