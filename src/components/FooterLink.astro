---
import EmailText from "./EmailText.astro";
import { typography } from "../../scripts/rehype-typography.mjs";
import LinkLabel from "./LinkLabel.astro";
import type { Lang } from "../data/ui";
interface Props {
  href: string;
  title: string;
  current: Lang;
  target?: Lang | "both";
  textLang?: Lang;
  download?: boolean;
}
const { href, current, target, textLang, download } = Astro.props;
const title = typography(Astro.props.title, textLang || current);
const email = /^[^\s@]+@[^\s@]+$/.test(title);
---
<a href={href} download={download || undefined}>{email ? <EmailText address={title} /> : <LinkLabel title={title} current={current} target={target} textLang={textLang} icon={download ? "down" : /^(https?:|mailto:)/.test(href) ? "external" : "right"} />}</a>
