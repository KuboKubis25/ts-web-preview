---
import Icon from "./Icon.astro";
import LinkLabel from "./LinkLabel.astro";
import { ui, type Lang } from "../data/ui";
import { url } from "../lib/urls";
const { lang } = Astro.props as { lang: Lang };
const t = ui[lang];
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim();
if (endpoint && !/^https:\/\//.test(endpoint))
  throw new Error("PUBLIC_FORM_ENDPOINT must be an HTTPS URL.");
---

<form
  class="enquiry-form"
  action={endpoint || "mailto:jakub.kubis@testing-service.org"}
  method="post"
  enctype={endpoint ? "application/x-www-form-urlencoded" : "text/plain"}
  data-mail-fallback={!endpoint || undefined}
>
  <h2 class="type-h3">{t.enquiry}</h2>
  <p class="small muted">{t.required}</p>
  <div class="form-row">
    <label for="name">
      {t.name} <span class="required-mark">*</span>
      <input
        id="name"
        aria-describedby="name-error"
        name="name"
        autocomplete="name"
        required
        maxlength="200"
      />
      <span class="field-error" id="name-error">
        {t.invalidRequired}
      </span>
    </label>
    <label for="email">
      {t.email} <span class="required-mark">*</span>
      <input
        id="email"
        aria-describedby="email-error"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
      />
      <span class="field-error" id="email-error">
        {t.invalidEmail}
      </span>
    </label>
  </div>
  <label for="company">
    {t.company}
    <input
      id="company"
      name="company"
      autocomplete="organization"
      maxlength="200"
    />
  </label>
  <label for="message">
    {t.message} <span class="required-mark">*</span>
    <textarea
      id="message"
      aria-describedby="message-error"
      name="message"
      rows="6"
      required
      maxlength="8000"
    ></textarea>
    <span class="field-error" id="message-error">
      {t.invalidRequired}
    </span>
  </label>
  <p class="small">
    <a class="text-link" href={url("ochrana-osobnych-udajov/")}>
      <LinkLabel title={t.readPrivacy} current={lang} target="sk" />
    </a>
  </p>
  {!endpoint && (
    <p class="small" id="mail-hint">
      {t.mailHint}
    </p>
  )}
  <button
    class="button button-primary"
    type="submit"
    aria-describedby={!endpoint ? "mail-hint" : undefined}
  >
    {endpoint ? t.send : t.mail} <Icon name={endpoint ? "right" : "external"} />
  </button>
</form>
<script>
  document
    .querySelector<HTMLFormElement>("form[data-mail-fallback]")
    ?.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(event.currentTarget as HTMLFormElement);
      const body = `${data.get("name")}\n${data.get("email")}\n${data.get("company")}\n\n${data.get("message")}`;
      location.href = `mailto:jakub.kubis@testing-service.org?subject=${encodeURIComponent("Testing Service — " + data.get("name"))}&body=${encodeURIComponent(body)}`;
    });
</script>
