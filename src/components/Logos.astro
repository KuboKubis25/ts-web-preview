---
import { Image } from "astro:assets";
import durr from "../../_source/img/Durr-optimized-logo.png";
import hyundai from "../../_source/img/Hyundai-250x250-bnw.png";
import kia from "../../_source/img/KIA-optimized-logo.png";
import rolls from "../../_source/img/Rolls-Royce-optimized.png";
import vw from "../../_source/img/WW-optimized-logo.png";
// Optical scale and painted-height fraction of each original square canvas.
const logos = [
  [durr, "Dürr", 0.85, 0.392],
  [hyundai, "Hyundai", 1, 0.544],
  [kia, "KIA", 0.9, 0.408],
  [rolls, "Rolls-Royce", 1.1, 0.64],
  [vw, "Volkswagen", 1.15, 0.672],
] as const;
---

<div class="logo-strip">
  {logos.map(([src, alt, scale, inkHeight]) => (
    <div style={`--logo-scale: ${scale}; --logo-ink-height: ${inkHeight}`}>
      <Image src={src} alt={alt} width={200} format="webp" loading="lazy" />
    </div>
  ))}
</div>
