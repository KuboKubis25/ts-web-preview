---
interface Props {
  name?: "right" | "external" | "down" | "chevron" | "menu" | "close" | "plus";
}
const { name = "right" } = Astro.props;
const paths = {
  right: "M3 8h10M8 3l5 5-5 5",
  external: "M4 12l8-8M4 4h8v8",
  down: "M8 3v10M3 8l5 5 5-5",
  chevron: "M3 5l5 5 5-5",
  menu: "M2 3h12M2 8h12M2 13h12",
  close: "M3 3l10 10M13 3L3 13",
  plus: "M3 8h10M8 3v10",
};
---

<svg
  class:list={["icon", `icon-${name}`]}
  width="16"
  height="16"
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  aria-hidden="true"
  focusable="false"
>
  <path d={name === "plus" ? "M3 8h10" : paths[name]} />
  {name === "plus" && <path class="icon-vertical" d="M8 3v10" />}
</svg>
