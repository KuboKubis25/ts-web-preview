---
import Icon from "./Icon.astro";
import type { Lang } from "../data/ui";
export interface Row {
  title: string;
  href: string;
  meta?: string;
  download?: boolean;
  lang?: Lang | "both";
}
interface Props { rows: Row[]; lang: Lang }
const { rows, lang } = Astro.props;
---
<ul class="list link-list">
  {rows.map((row) => {
    const language = row.lang && row.lang !== "both" && row.lang !== lang
      ? row.lang === "zh" ? "中文" : row.lang.toUpperCase() : undefined;
    const meta = [row.meta, language].filter(Boolean).join(" · ");
    return <li><a href={row.href} download={row.download || undefined}>
      <span class="list-title">{row.title}</span>
      {meta && <small>{meta}</small>}
      <Icon name={row.download ? "down" : /^(https?:|mailto:)/.test(row.href) ? "external" : "right"} />
    </a></li>;
  })}
</ul>
