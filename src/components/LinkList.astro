---
import EmailText from "./EmailText.astro";
import { typography } from "../../scripts/rehype-typography.mjs";
import Icon from "./Icon.astro";
import type { Lang } from "../data/ui";
export interface Row {
  title: string;
  href: string;
  meta?: string;
  download?: boolean;
  lang?: Lang | "both";
}
interface Props { rows: Row[]; lang: Lang }
const { rows, lang } = Astro.props;
---
<ul class="list link-list">
  {rows.map((row) => {
    const language = row.lang && row.lang !== "both" && row.lang !== lang
      ? row.lang === "zh" ? "中文" : row.lang.toUpperCase() : undefined;
    const email = /^[^\s@]+@[^\s@]+$/.test(row.title);
    const meta = [email ? undefined : row.meta, language].filter(Boolean).join(" · ");
    return <li><a href={row.href} download={row.download || undefined}>
      <span class:list={["list-title", email && "email-title"]}>{email ? <EmailText address={row.title} /> : typography(row.title, lang)}</span>
      {meta && <small>{meta}</small>}
      {!email && <Icon name={row.download ? "down" : /^(https?:|mailto:)/.test(row.href) ? "external" : "right"} />}
    </a></li>;
  })}
</ul>
