---
import type { Lang } from "../data/ui";
interface Props {
  current: Lang;
  target: Lang | "both";
}
const { current, target } = Astro.props;
---

{target !== "both" && current !== target && (
  <>
    {"\u00a0"}<span class="lang-tag" lang={target}>
      {target === "zh" ? "中文" : target.toUpperCase()}
    </span>
  </>
)}
