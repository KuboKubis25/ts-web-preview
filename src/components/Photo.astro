---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  name: string;
  alt: string;
  class?: string;
  eager?: boolean;
  sizes?: string;
  widths?: number[];
}
const {
  name,
  alt,
  class: className,
  eager = false,
  widths = [400, 760, 1200, 1600],
  sizes = "(min-width: 1080px) 50vw, 100vw",
} = Astro.props;
const assets = import.meta.glob<{ default: ImageMetadata }>(
  "../../_source/img/*.{jpg,JPG,png}",
  { eager: true },
);
const src = assets[`../../_source/img/${name}`]?.default;
if (!src) throw new Error(`Missing source image: ${name}`);
---

<Image
  src={src}
  alt={alt}
  class={className}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : "auto"}
  decoding="async"
/>
